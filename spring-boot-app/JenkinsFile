pipeline {
    agent {
        docker {
            image 'jibin321/maven-docker-agent:v2'
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    options {
        skipDefaultCheckout(true)
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build and Test') {
            steps {
                sh 'ls -ltr'

                dir('spring-boot-app') {
                    sh 'mvn clean package'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('spring-boot-app') {
                    withSonarQubeEnv('sonarqube') {
                        sh '''
                            mvn org.sonarsource.scanner.maven:sonar-maven-plugin:5.1.0.4751:sonar \
                            -Dsonar.projectKey=my-ec2-project \
                            -Dsonar.projectName="Spring Boot App" \
                            -Dsonar.host.url=$SONAR_HOST_URL
                        '''
                    }
                }
            }
        }

        stage('Build and Push Docker Image') {
            environment {
                DOCKER_IMAGE = "abintony/spring-boot-app:${BUILD_NUMBER}"
            }

            steps {
                script {
                    sh 'docker build -t ${DOCKER_IMAGE} ./spring-boot-app'

                    def dockerImage = docker.image("${DOCKER_IMAGE}")

                    docker.withRegistry(
                        'https://index.docker.io/v1/',
                        'docker-cred'
                    ) {
                        dockerImage.push()
                        dockerImage.push('latest')
                    }
                }
            }
        }

        stage('Update Deployment File') {
            environment {
                GIT_REPO_NAME = "java-maven-sonar-argocd"
                GIT_USER_NAME = "Abintony24"
            }

            steps {
                withCredentials([
                    string(
                        credentialsId: 'github',
                        variable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        git config --global user.email "abintony24@gmail.com"
                        git config --global user.name "${GIT_USER_NAME}"

                        git config --global --add safe.directory /var/lib/jenkins/workspace/javen-maven-spring-boot-app

                        git init

                        git remote remove origin 2>/dev/null || true

                        git remote add origin https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git

                        git fetch origin main

                        git checkout -B main origin/main

                        sed -i "s|image: .*|image: abintony/spring-boot-app:${BUILD_NUMBER}|g" spring-boot-app-manifests/deployment.yml

                        git add spring-boot-app-manifests/deployment.yml

                        git commit -m "Update image tag to ${BUILD_NUMBER} [skip ci]" || echo "No changes to commit"

                        git push origin main
                    '''
                }
            }
        }
    }
}
